<diagram id="build" name="3 Build tasks"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t0" value="Orchestrator&lt;br&gt;&lt;br&gt;skeleton PR, three.js in, Plot out, check.ps1, .gitattributes, main.ts mount()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#151622;strokeColor=none;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="140" height="230" as="geometry"/></mxCell><mxCell id="t1" value="Coder A + B (parallel)&lt;br&gt;&lt;br&gt;A: pipeline → tests.json, experiments.json, psi-text.json, COVERAGE · B: data layer, nearestTests, Moon box" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b2b85;strokeColor=none;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="170" y="40" width="140" height="230" as="geometry"/></mxCell><mxCell id="te1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="t0" target="t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t2" value="Coder C + D + E (parallel)&lt;br&gt;&lt;br&gt;C: story engine + story-demo · D: SVG stage + sliders · E: slider panel, nearest list, analyst table" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b2b85;strokeColor=none;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="40" width="140" height="230" as="geometry"/></mxCell><mxCell id="te2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t3" value="Orchestrator + D&lt;br&gt;&lt;br&gt;local preview (npm run preview), optional three.js tilt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b2b85;strokeColor=none;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="470" y="40" width="140" height="230" as="geometry"/></mxCell><mxCell id="te3" value="" style="edge