<mxCell id="g1" value="click a story" style="endArrow=block;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="a3" target="B"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="C" value="Act 2 is ONE scene: families fill the plane one at a time (cut to SAFFIRE, FLEX, SAME-R if short) · Act 1: Hook-Reveal-Takeaway · Act 3: all 5 + sliders · Act 4: one beat on the labelled empty lunar plane" style="swimlane;startSize=30;fillColor=#ff5804;fontColor=#ffffff;strokeColor=#ff5804;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1360" height="120" as="geometry"/></mxCell>
<mxCell id="c1" value="Large-scale fires&lt;br&gt;SAFFIRE I-III" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5804;" vertex="1" parent="C"><mxGeometry x="20" y="45" width="200" height="55" as="geometry"/></mxCell>
<mxCell id="c2" value="Solids in a flow duct&lt;br&gt;BASS, BASS-II" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5804;" vertex="1" parent="C"><mxGeometry x="240" y="45" width="200" height="55" as="geometry"/></mxCell>
<mxCell id="c3" value="Gas jets&lt;br&gt;ACME family, SPICE, SLICE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5804;" vertex="1" parent="C"><mxGeometry x="460" y="45" width="200" height="55" as="geometry"/></mxCell>
<mxCell id="c4" value="Droplets&lt;br&gt;FLEX, FLEX-2, CFI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5804;" vertex="1" parent="C"><mxGeometry x="680" y="45" width="200" height="55" as="geometry"/></mxCell>
<mxCell id="c5" value="Smoke detection&lt;br&gt;SAME, SAME-R" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5804;" vertex="1" parent="C"><mxGeometry x="900" y="45" width="200" height="55" as="geometry"/></mxCell>
<mxCell id="c6" value="Ground and modelling studies" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5804;" vertex="1" parent="C"><mxGeometry x="1120" y="45" width="210" height="55" as="geometry"/></mxCell>
</root>
