<diagram id="story" name="2 Story structure">
<mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="A" value="Home opens on Act 1 (Start here) · Stories rail opens a Stories overlay · Skip to Moon air chip" style="swimlane;startSize=30;fillColor=#151622;fontColor=#ffffff;strokeColor=#151622;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1360" height="190" as="geometry"/></mxCell>
<mxCell id="a1" value="&lt;b&gt;1 · Why oxygen matters&lt;/b&gt;&lt;br&gt;Apollo 1 (1967) → Mir (1997)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e52207;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="A"><mxGeometry x="20" y="45" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="a2" value="&lt;b&gt;2 · What NASA has tested&lt;/b&gt;&lt;br&gt;6 family scenes, 22 investigations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ff5804;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="A"><mxGeometry x="260" y="45" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="a3" value="&lt;b&gt;3 · Build your Moon-base air&lt;/b&gt;&lt;br&gt;sliders, nearest real tests" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7f434;fontColor=#1b1b1b;strokeColor=none;" vertex="1" parent="A"><mxGeometry x="500" y="45" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="a4" value="&lt;b&gt;4 · What nobody knows yet&lt;/b&gt;&lt;br&gt;the empty lunar-gravity plane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b2b85;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="A"><mxGeometry x="740" y="45" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="a5" value="&lt;b&gt;Analyst table&lt;/b&gt;&lt;br&gt;all tests + 22 experiment pages" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d4551;" vertex="1" parent="A"><mxGeometry x="1000" y="45" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="a6" value="Lens: Astronaut · Analyst · Public    |    Language: EN · ES · HI (AR later)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="A"><mxGeometry x="20" y="135" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="B" value="Inside a story: the stage stays pinned, text steps scroll past it, each step changes what the data shows" style="swimlane;startSize=30;fillColor=#1b2b85;fontColor=#ffffff;strokeColor=#1b2b85;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="1360" height="330" as="geometry"/></mxCell>
<mxCell id="st" value="&lt;b&gt;Pinned stage&lt;/b&gt;&lt;br&gt;three.js evidence space&lt;br&gt;x = pressure kPa · y = oxygen %&lt;br&gt;z = gravity: micro-g · lunar · 1 g" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#151622;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="B"><mxGeometry x="20" y="50" width="300" height="260" as="geometry"/></mxCell>
<mxCell id="b1" value="&lt;b&gt;1 Hook&lt;/b&gt;&lt;br&gt;a question, no data yet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2b85;" vertex="1" parent="B"><mxGeometry x="380" y="60" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="b2" value="&lt;b&gt;2 Reveal&lt;/b&gt;&lt;br&gt;the data appears" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2b85;" vertex="1" parent="B"><mxGeometry x="570" y="60" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="b3" value="&lt;b&gt;3 Focus&lt;/b&gt;&lt;br&gt;one group lights up, labelled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2b85;" vertex="1" parent="B"><mxGeometry x="760" y="60" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="b4" value="&lt;b&gt;4 Compare&lt;/b&gt;&lt;br&gt;a reference joins: ISS air, Moon box" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2b85;" vertex="1" parent="B"><mxGeometry x="950" y="60" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="b5" value="&lt;b&gt;5 Takeaway&lt;/b&gt;&lt;br&gt;one sentence per lens + source link → next story" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2b85;" vertex="1" parent="B"><mxGeometry x="1140" y="60" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="bn" value="Each step fires at mid-screen; scrolling back reverses it. Stage is 2D SVG first; three.js only for the tilt to the empty lunar plane. Public lens default; Analyst slides in the data sheet. Nearest = nearest tested conditions, not a prediction." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#3d4551;" vertex="1" parent="B"><mxGeometry x="380" y="150" width="950" height="50" as="geometry"/></mxCell>
<mxCell id="x0" value="&lt;b&gt;Example: story 3, Moon-base air&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="B"><mxGeometry x="380" y="200" width="400" height="20" as="geometry"/></mxCell>
<mxCell id="x1" value="Could a Moon base catch fire more easily than the ISS?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dfe1e2;strokeColor=none;fontSize=11;" vertex="1" parent="B"><mxGeometry x="380" y="225" width="170" height="85" as="geometry"/></mxCell>
<mxCell id="x2" value="All PSI tests drop onto the micro-g plane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dfe1e2;strokeColor=none;fontSize=11;" vertex="1" parent="B"><mxGeometry x="570" y="225" width="170" height="85" as="geometry"/></mxCell>
<mxCell id="x3" value="Tests nearest 56.5 kPa / 34-40 % O2 turn blue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dfe1e2;strokeColor=none;fontSize=11;" vertex="1" parent="B"><mxGeometry x="760" y="225" width="170" height="85" as="geometry"/></mxCell>
<mxCell id="x4" value="Moon box appears on the empty lunar plane; ISS air 101.4 kPa / 21 % marked" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dfe1e2;strokeColor=none;fontSize=11;" vertex="1" parent="B"><mxGeometry x="950" y="225" width="170" height="85" as="geometry"/></mxCell>
<mxCell id="x5" value="Sliders unlock: drag your own air, see the 10 nearest real tests" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7f434;strokeColor=none;fontSize=11;" vertex="1" parent="B"><mxGeometry x="1140" y="225" width="190" height="85" as="geometry"/></mxCell>
<mxCell id="f1" style="endArrow=block;html=1;" edge="1" parent="B" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f2" style="endArrow=block;html=1;" edge="1" parent="B" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
