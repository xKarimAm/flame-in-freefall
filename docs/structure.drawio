<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="L1" value="1. NASA sources (verified)" style="swimlane;startSize=30;fillColor=#151622;fontColor=#ffffff;strokeColor=#151622;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="240" height="420" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;PSI snapshot&lt;/b&gt;&lt;br&gt;22 investigations, ~1,780 test rows&lt;br&gt;CSV + JSON, CC0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dfe1e2;strokeColor=#3d4551;" vertex="1" parent="L1"><mxGeometry x="20" y="50" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;Curated facts&lt;/b&gt;&lt;br&gt;moon.json, incidents.json&lt;br&gt;each fact has a NASA URL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dfe1e2;strokeColor=#3d4551;" vertex="1" parent="L1"><mxGeometry x="20" y="170" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;Investigation objectives + papers&lt;/b&gt;&lt;br&gt;source text for summaries" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dfe1e2;strokeColor=#3d4551;" vertex="1" parent="L1"><mxGeometry x="20" y="290" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="L2" value="2. Pipeline (Python, pytest)" style="swimlane;startSize=30;fillColor=#1b2b85;fontColor=#ffffff;strokeColor=#1b2b85;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="240" height="420" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b&gt;Parse + normalise&lt;/b&gt;&lt;br&gt;units: O2 %, kPa, cm/s, s&lt;br&gt;bad cells = null, raw kept" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2b85;" vertex="1" parent="L2"><mxGeometry x="20" y="50" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;Validate against contracts&lt;/b&gt;&lt;br&gt;golden rows exact, ranges,&lt;br&gt;source on every row" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2b85;" vertex="1" parent="L2"><mxGeometry x="20" y="140" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;data/build/&lt;/b&gt;&lt;br&gt;tests.json, experiments.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2491ff;fontColor=#ffffff;strokeColor=#0050d8;" vertex="1" parent="L2"><mxGeometry x="20" y="230" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="p4" value="&lt;b&gt;Prepared AI summaries&lt;/b&gt;&lt;br&gt;quotes checked word for word&lt;br&gt;summaries.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2b85;" vertex="1" parent="L2"><mxGeometry x="20" y="310" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="L3" value="3. Story content (JSON)" style="swimlane;startSize=30;fillColor=#ff5804;fontColor=#ffffff;strokeColor=#ff5804;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="580" y="40" width="240" height="420" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;stories/*.json&lt;/b&gt;&lt;br&gt;story → scenes → beats" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5804;" vertex="1" parent="L3"><mxGeometry x="20" y="50" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;A beat =&lt;/b&gt;&lt;br&gt;stage state (what data shows)&lt;br&gt;+ text per lens + source links" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5804;" vertex="1" parent="L3"><mxGeometry x="20" y="140" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;i18n/&lt;/b&gt;&lt;br&gt;en now · es, hi next&lt;br&gt;ar last (right-to-left)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5804;" vertex="1" parent="L3"><mxGeometry x="20" y="250" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="L4" value="4. Web app (Vite + TS + three.js, vitest)" style="swimlane;startSize=30;fillColor=#1b1b1b;fontColor=#ffffff;strokeColor=#1b1b1b;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="860" y="40" width="270" height="420" as="geometry"/></mxCell>
<mxCell id="w1" value="&lt;b&gt;Data layer&lt;/b&gt;&lt;br&gt;loader, nearestTests(),&lt;br&gt;moonBox, lunarMargins" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b1b1b;" vertex="1" parent="L4"><mxGeometry x="20" y="50" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="w2" value="&lt;b&gt;Story engine&lt;/b&gt;&lt;br&gt;scroll position → active beat&lt;br&gt;→ stage state" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b1b1b;" vertex="1" parent="L4"><mxGeometry x="20" y="140" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="w3" value="&lt;b&gt;Stage&lt;/b&gt;&lt;br&gt;three.js evidence space&lt;br&gt;+ flat SVG fallback" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7f434;strokeColor=#1b1b1b;" vertex="1" parent="L4"><mxGeometry x="20" y="230" width="110" height="80" as="geometry"/></mxCell>
<mxCell id="w4" value="&lt;b&gt;UI&lt;/b&gt;&lt;br&gt;story picker, lens + language switch, analyst table, 22 experiment pages" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b1b1b;" vertex="1" parent="L4"><mxGeometry x="140" y="230" width="110" height="140" as="geometry"/></mxCell>
<mxCell id="L5" value="5. Ship" style="swimlane;startSize=30;fillColor=#3d4551;fontColor=#ffffff;strokeColor=#3d4551;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="1170" y="40" width="200" height="420" as="geometry"/></mxCell>
<mxCell id="h1" value="scripts/check.ps1&lt;br&gt;pytest + vitest + build&lt;br&gt;green = merge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d4551;" vertex="1" parent="L5"><mxGeometry x="20" y="50" width="160" height="60" as="geometry"/></mxCell>
