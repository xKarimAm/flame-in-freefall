{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "firebreak-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "firebreak-night",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "E:/fif-wt/night-web/web",
        "run",
        "preview",
        "--",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    },
    {
      "name": "firebreak-phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "E:/fif-wt/night-web/web",
        "run",
        "preview",
        "--",
        "--host",
        "--port",
        "4175",
        "--strictPort"
      ],
      "port": 4175
    },
    {
      "name": "firebreak-release",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "E:/fif-wt/release/web",
        "run",
